{
  "name": "umnaapp",
  "version": "1.0.0",
  "description": "UMNAAPP - Full-stack map-based web application",
  "private": true,
  "workspaces": [
    "frontend",
    "admin",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:admin\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:admin": "cd admin && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "install:all": "npm install && cd frontend && npm install && cd ../admin && npm install && cd ../backend && npm install"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "vite": "6.4.3"
  },
  "overrides": {
    "axios": "1.19.0",
    "form-data": "4.0.6",
    "follow-redirects": "1.16.0",
    "ws": "8.21.1",
    "engine.io": "6.6.9",
    "engine.io-client": "6.6.6",
    "socket.io-parser": "4.2.7",
    "socket.io-adapter": "2.5.8",
    "path-to-regexp": "0.1.13",
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6",
    "picomatch": "4.0.5",
    "lodash": "4.18.1",
    "body-parser": "1.20.6",
    "qs": "6.15.3",
    "uuid": "11.1.1",
    "rollup": "4.62.3",
    "postcss": "8.5.25",
    "nodemailer": "9.0.3",
    "fast-uri": "4.1.1",
    "@babel/core": "7.29.7",
    "vite": "6.4.3"
  }
}
